# Copy to .env.local and fill in what you need.

# Turns on Google Drive backups (see README → "Google Drive backups").
# This is a public OAuth client ID, not a secret.
VITE_GOOGLE_CLIENT_ID=

# Optional for local development: a real Postgres instead of the built-in local database in .data/pglite.
# In production these are set on Render (see docs/DATABASE.md). Never commit real values, and never
# give them a VITE_ prefix: VITE_ variables are copied into the public JavaScript (the build refuses).
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
